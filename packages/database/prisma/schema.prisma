generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id             String   @id @default(uuid())
  name           String
  description    String?
  /// Free-form owner label (team or person) until users/teams are modelled.
  owner          String?
  repositoryUrl  String   @unique
  /// Where the repository lives, e.g. "github". Null for manually registered projects.
  sourceProvider String?
  /// The provider's stable repository id (survives renames and transfers).
  sourceRepoId   String?
  defaultBranch  String?
  /// Avatar of the repository owner (user/org) on the provider.
  avatarUrl      String?
  /// Primary language as reported by the provider, e.g. "TypeScript".
  language       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  environments   Environment[]

  @@unique([sourceProvider, sourceRepoId])
}

/// A person who signs in to Launchpad (currently always via GitHub).
model User {
  id               String            @id @default(uuid())
  /// GitHub's numeric user id: stable even if the user renames their login.
  githubId         BigInt            @unique
  login            String
  name             String?
  avatarUrl        String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  sessions         Session[]
  githubCredential GitHubCredential?
  cloudAccounts    CloudAccount[]
  auditEvents      AuditEvent[]
  requestedRuns    InfrastructureRun[] @relation("RunRequestedBy")
  approvedRuns     InfrastructureRun[] @relation("RunApprovedBy")
}

/// A signed-in browser session. The cookie holds a random token; only its
/// SHA-256 hash is stored, so a database leak does not leak live sessions.
model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// GitHub user-to-server tokens, encrypted at rest (AES-256-GCM, ENCRYPTION_KEY).
model GitHubCredential {
  userId                String    @id
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessTokenEncrypted  String
  accessTokenExpiresAt  DateTime?
  refreshTokenEncrypted String?
  refreshTokenExpiresAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

enum JobStatus {
  queued
  running
  succeeded
  failed
  cancelled
}

/// Durable background job, executed by the worker. Postgres is the queue:
/// workers claim rows with FOR UPDATE SKIP LOCKED, so jobs survive restarts
/// and two workers never run the same job.
model Job {
  id          String    @id @default(uuid())
  /// Handler name, e.g. "terraform.plan".
  type        String
  payload     Json      @default("{}")
  status      JobStatus @default(queued)
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  /// Not picked up before this time (used for scheduling and retry backoff).
  runAt       DateTime  @default(now())
  lockedAt    DateTime?
  lockedBy    String?
  lastError   String?
  result      Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  finishedAt  DateTime?

  @@index([status, runAt])
}

enum CloudAccountStatus {
  /// Created; waiting for the customer to create the IAM role.
  pending
  connected
  error
}

/// A customer-owned cloud account Launchpad may act in. For AWS, Launchpad
/// assumes  with  per operation; no long-lived
/// credentials for the account are ever stored.
model CloudAccount {
  id             String             @id @default(uuid())
  provider       String
  name           String
  /// Provider account id (12 digits on AWS). Known once verified.
  accountId      String?
  roleArn        String?
  /// Random value the role's trust policy requires (confused-deputy protection).
  externalId     String             @unique
  region         String
  status         CloudAccountStatus @default(pending)
  lastVerifiedAt DateTime?
  lastError      String?
  createdById    String?
  createdBy      User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  environments   Environment[]

  @@unique([provider, accountId])
}

/// Append-only record of sensitive operations (who did what, when).
model AuditEvent {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  /// e.g. "cloud_account.connected"
  action     String
  targetType String
  targetId   String
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([createdAt])
}

enum EnvironmentKind {
  development
  staging
  production
}

/// Who may approve an environment's infrastructure changes.
enum ApprovalPolicy {
  /// The person who requested the plan may approve it (small teams).
  any_member
  /// A different person must approve (four-eyes, default for production).
  different_member
}

/// A deployable instance of a project (e.g. its staging environment) in a
/// connected cloud account. Its infrastructure comes from a Launchpad stack.
model Environment {
  id             String          @id @default(uuid())
  projectId      String
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name           String
  kind           EnvironmentKind
  /// Immutable prefix for cloud resource names (e.g. "payments-api-staging").
  /// Fixed at creation so renaming the project never re-creates infrastructure.
  slug           String          @unique
  cloudAccountId String
  /// Restrict: infrastructure must be torn down before its account is removed.
  cloudAccount   CloudAccount    @relation(fields: [cloudAccountId], references: [id], onDelete: Restrict)
  region         String
  approvalPolicy ApprovalPolicy  @default(any_member)
  /// Developer-facing stack inputs (validated by ServiceSettingsSchema in
  /// @launchpad/contracts). Applied only through plan -> approve -> apply.
  serviceSettings Json           @default("{}")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  runs           InfrastructureRun[]

  @@unique([projectId, name])
}

enum InfrastructureRunStatus {
  queued
  planning
  /// Plan ready, waiting for a human decision.
  planned
  /// Plan found nothing to change.
  no_changes
  approved
  applying
  applied
  rejected
  /// A newer plan for the same environment replaced this one.
  superseded
  failed
}

enum InfrastructureOperation {
  /// Create/update infrastructure to match the stack.
  apply
  /// Tear down everything the stack created.
  destroy
}

/// One plan -> approve -> apply cycle for an environment's infrastructure.
model InfrastructureRun {
  id            String                  @id @default(uuid())
  environmentId String
  environment   Environment             @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  operation     InfrastructureOperation @default(apply)
  status        InfrastructureRunStatus @default(queued)
  /// { add, change, destroy, resources: [{ address, actions }] }
  summary       Json?
  planLog       String?
  applyLog      String?
  outputs       Json?
  error         String?
  planJobId     String?
  applyJobId    String?
  requestedById String?
  requestedBy   User?                   @relation("RunRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  approvedById  String?
  approvedBy    User?                   @relation("RunApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt    DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  finishedAt    DateTime?

  @@index([environmentId, createdAt])
}
