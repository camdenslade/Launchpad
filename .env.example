NODE_ENV=development

PORT=3000

DATABASE_URL=postgresql://launchpad:launchpad_local@localhost:5433/launchpad

# Public URL of the web app. GitHub's callback is ${WEB_ORIGIN}/api/auth/github/callback
WEB_ORIGIN=http://localhost:5173

# 32-byte base64 key used to encrypt stored credentials. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never commit it. Losing it makes stored tokens unreadable (users just sign in again).
ENCRYPTION_KEY=

# How long a sign-in lasts, in hours (default 7 days).
SESSION_TTL_HOURS=168

# GitHub App credentials (Settings > Developer settings > GitHub Apps).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional: the app's URL name (github.com/apps/<slug>). Enables a direct
# "install the app" link; otherwise users are sent to their installations page.
GITHUB_APP_SLUG=

# AWS identity Launchpad itself runs as (standard AWS SDK credential chain).
# Locally: the name of an AWS CLI profile. In production on AWS, leave unset
# and give the server an instance/task role instead of keys.
AWS_PROFILE=
